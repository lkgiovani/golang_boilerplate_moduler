# Application
SERVICE_NAME=boilerplate-api
PORT=3000
APP_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# Database (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/boilerplate
DATABASE_MAX_CONNECTIONS=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Email / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=SaaS Boilerplate

# JWT
JWT_ACCESS_SECRET=change-me-in-production-32chars!
JWT_REFRESH_SECRET=change-me-refresh-production-32!
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7
JWT_ISSUER=saas-boilerplate

# OpenTelemetry (optional — leave empty to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf